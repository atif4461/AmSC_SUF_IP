   ostr << "\'";
   return PyUnicode_FromString(ostr.str().c_str());
}

static PyObject*
_istream_iter(PyObject *self)
{
   Py_INCREF(self);
   return self;
}
static PyObject*
_istream_next(PyObject *self)
{
   PyObject *rec = _istream_read(self, 0);
   if (rec == NULL)
      PyErr_SetString(PyExc_StopIteration, "no more data on input stream");
   return rec;
}

