_istream_read(PyObject *self, PyObject *args)
{
   istream *istr = ((_istream*)self)->istr;
   if (istr == 0) {
      PyErr_SetString(PyExc_TypeError, "unexpected null input stream");
      return NULL;
   }
   _HDDM *record_obj = (_HDDM*)_HDDM_new(&_HDDM_type, 0, 0);
