static void
_FcalHit_dealloc(_FcalHit* self)
{
   if (self->elem != 0) {
      LOG_DEALLOC(Py_TYPE(self), 0, self->host == (PyObject*)self);
      if (self->host == (PyObject*)self)
         delete self->elem;
      else
         My_DECREF(self->host);
   }
   Py_TYPE(self)->tp_free((PyObject*)self);
}

